        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="lower_link_servo" joint="lower_link" ctrlrange="-1.5708 1.5708" forcerange="-1 1" kp="8" kv="0.3"/>
    <position name="upper_link_servo" joint="upper_link" ctrlrange="-1.5708 1.5708" forcerange="-1 1" kp="8" kv="0.3"/>
  </actuator>
</mujoco>
