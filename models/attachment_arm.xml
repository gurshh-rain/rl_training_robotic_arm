      <body name="lower_arm" pos="0 0 0" euler="1.5708 0 0">
        <joint name="lower_link" type="hinge" axis="1 0 0" range="-1.5708 1.5708" damping="0.02" armature="0.001"/>
        <inertial pos="0.0303299 -0.00260215 0.0367362" mass="0.0546052" diaginertia="0.0000106861 0.0000185359 0.0000144788"/>
        <geom name="lower_arm_geom" type="mesh" mesh="lower_arm_mesh" material="robot_mat" friction="0.8 0.005 0.0001"/>

        <body name="upper_arm" pos="0.028367 -0.026145 0.060445">
